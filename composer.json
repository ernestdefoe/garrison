{
    "name": "ernestdefoe/garrison",
    "description": "Garrison — run your game servers from the forum the players already live in. Any server you can install, with or without Docker.",
    "type": "flarum-extension",
    "keywords": ["flarum", "game", "server", "minecraft", "valheim", "panel"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Garrison\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Garrison",
            "category": "feature",
            "icon": {
                "name": "fas fa-tower-observation",
                "backgroundColor": "#1c2429",
                "color": "#e5823f"
            },
            "optional-dependencies": [
                "fof/forum-widgets-core",
                "ernestdefoe/bespoke",
                "ernestdefoe/page-builder"
            ]
        }
    }
}
